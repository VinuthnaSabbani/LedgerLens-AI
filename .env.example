# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Razorpay Test Mode Credentials (Optional)
RAZORPAY_KEY_ID="rzp_test_sampleKey123"
RAZORPAY_KEY_SECRET="sampleSecretKey456"

# MySQL Database Configuration (Optional - falls back to high-performance in-memory mock if not configured)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="ledgerlens_db"

# Server Port
PORT=3000
